{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SanctumThemeTokenSchema",
  "description": "Validation schema for Sanctum custom theme tokens. Forbids remote resources, scripts, url(), @import, and unrecognized keys.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "colors"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{2,32}$",
      "description": "Unique identifier for custom theme"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[A-Za-z0-9 _-]+$",
      "description": "Human-readable label"
    },
    "author": {
      "type": "string",
      "maxLength": 48
    },
    "colors": {
      "$ref": "#/definitions/ColorTokens"
    },
    "darkColors": {
      "$ref": "#/definitions/ColorTokens"
    }
  },
  "definitions": {
    "HexColor": {
      "type": "string",
      "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8}|[A-Fa-f0-9]{3})$",
      "not": {
        "pattern": "(url\\(|@import|javascript:|http:|https:|data:)"
      }
    },
    "ColorTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "foreground",
        "card",
        "primary",
        "border"
      ],
      "properties": {
        "background": { "$ref": "#/definitions/HexColor" },
        "foreground": { "$ref": "#/definitions/HexColor" },
        "card": { "$ref": "#/definitions/HexColor" },
        "cardForeground": { "$ref": "#/definitions/HexColor" },
        "muted": { "$ref": "#/definitions/HexColor" },
        "mutedForeground": { "$ref": "#/definitions/HexColor" },
        "primary": { "$ref": "#/definitions/HexColor" },
        "primaryForeground": { "$ref": "#/definitions/HexColor" },
        "border": { "$ref": "#/definitions/HexColor" },
        "input": { "$ref": "#/definitions/HexColor" },
        "accent": { "$ref": "#/definitions/HexColor" },
        "accentForeground": { "$ref": "#/definitions/HexColor" },
        "sidebarBackground": { "$ref": "#/definitions/HexColor" },
        "sidebarBorder": { "$ref": "#/definitions/HexColor" },
        "userBubble": { "$ref": "#/definitions/HexColor" },
        "success": { "$ref": "#/definitions/HexColor" },
        "warning": { "$ref": "#/definitions/HexColor" },
        "danger": { "$ref": "#/definitions/HexColor" }
      }
    }
  }
}
