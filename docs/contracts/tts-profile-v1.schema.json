{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanctum.local/contracts/tts-profile-v1.schema.json",
  "title": "Local TTS profile v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "engine", "egress", "executable_path", "executable_sha256", "voices", "timeout_seconds"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "engine": {"const": "flite"},
    "egress": {"const": "denied"},
    "executable_path": {"type": "string", "minLength": 1},
    "executable_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
    "voices": {"type": "object", "minProperties": 1, "additionalProperties": {
      "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"
    }}
  }
}
