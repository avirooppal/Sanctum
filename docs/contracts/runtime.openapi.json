{
  "openapi": "3.1.0",
  "info": {
    "title": "Sanctum runtime health",
    "version": "0.2.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "runtimeHealth",
        "responses": {
          "200": {
            "description": "Kernel startup checks passed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/healthz/dispatch": {
      "get": {
        "operationId": "dispatchCounts",
        "responses": {
          "200": {
            "description": "Aggregate lane counts in control, voice, chat, background order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "queued",
                    "active"
                  ],
                  "properties": {
                    "queued": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "active": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "cloud_connectors",
          "isolation",
          "checks"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "cloud_connectors": {
            "const": "disabled"
          },
          "isolation": {
            "const": "linux-user-netns-seccomp"
          },
          "checks": {
            "type": "object",
            "minProperties": 8,
            "additionalProperties": {
              "const": "denied"
            }
          }
        }
      }
    }
  }
}
