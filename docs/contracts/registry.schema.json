{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanctum model and dependency registry",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "models", "dependencies"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "models": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "license", "license_url", "verified_at", "sha256", "format", "capabilities", "source", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "license": {"enum": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC", "CC0-1.0", "MIT AND CC-BY-4.0", "LicenseRef-CMU-Flite"]},
        "attribution": {"type": "string", "minLength": 1},
        "upstream_source": {"type": "string", "format": "uri"},
        "upstream_revision": {"type": "string", "minLength": 1},
        "license_url": {"type": "string", "format": "uri"},
        "verified_at": {"type": "string", "format": "date"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "format": {"enum": ["gguf", "safetensors", "onnx", "ggml", "native-voice"]},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["text", "vision", "tools", "reasoning", "embedding", "rerank", "asr", "tts", "vad"]}},
        "source": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"format": {"const": "ggml"}}}, "then": {"properties": {"capabilities": {"enum": [["asr"], ["vad"]]}}}},
        {"if": {"properties": {"license": {"const": "MIT AND CC-BY-4.0"}}}, "then": {"required": ["attribution", "upstream_source", "upstream_revision"], "properties": {"capabilities": {"const": ["asr"]}}}},
        {"if": {"properties": {"format": {"const": "native-voice"}}}, "then": {"required": ["attribution"], "properties": {"capabilities": {"const": ["tts"]}, "license": {"const": "LicenseRef-CMU-Flite"}}}},
        {"if": {"properties": {"license": {"const": "LicenseRef-CMU-Flite"}}}, "then": {"properties": {"format": {"const": "native-voice"}}}}
      ]
    }},
    "dependencies": {"type": "array", "items": {"type": "object", "required": ["name", "version", "license", "license_source"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "license": {"type": "string", "minLength": 1}, "license_source": {"type": "string", "minLength": 1}}}}
  }
}
